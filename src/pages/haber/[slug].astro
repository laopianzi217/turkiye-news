---
import BaseLayout from '../../layouts/BaseLayout.astro';
import categories from '../../../data/categories.json';
import news from '../../data/news.json';
export function getStaticPaths(){return news.filter((item)=>item.slug).map((item)=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props;
const category=categories.categories.find((c)=>c.id===item.category);
const dateLabel=item.publishedAt?new Date(item.publishedAt).toLocaleDateString('tr-TR',{day:'numeric',month:'long',year:'numeric'}):'Güncel';
---
<BaseLayout title={item.title+' — Günce'} description={item.description}><article class="wrap story-page news-story"><a class="back-link" href={'/kategori/'+(category?.slug??'yasam')+'/'}>← {category?.name??'Yaşam'}</a><header class="story-header"><p class="eyebrow">{category?.name??'Yaşam'} · {dateLabel}</p><h1>{item.title}</h1><p class="story-deck">{item.description}</p><p class="news-attribution">{item.attribution || item.sourceName}</p></header>{item.image&&<img class="news-hero-image" src={item.image} alt="" loading="lazy" /> }<div class="story-body news-content" set:html={item.contentHtml || '<p>'+(item.description||'')+'</p>'}></div><div class="news-source-note">{item.attribution || item.sourceName} · Haber içeriği Press Haber Ajansı (PHA) akışından alınmıştır.</div><div class="story-end"><span>GÜNCE.</span><a class="text-link" href="/">Diğer haberlere göz at →</a></div></article></BaseLayout>
