---
import BaseLayout from '../../layouts/BaseLayout.astro';
import categories from '../../../data/categories.json';
import news from '../../data/news.json';
export function getStaticPaths(){return news.filter((item)=>item.slug).map((item)=>({params:{slug:item.slug},props:{item}}));}
const {item}=Astro.props;
const category=categories.categories.find((c)=>c.id===item.category);
const contentLabel = item.sourceId === 'matrixqr-blog' ? 'Sponsorlu içerik' : (item.contentType === 'brand_release' || item.sourceId === 'basin-bultenleri' ? 'Marka bülteni' : 'Ajans haberi');
const dateLabel=item.publishedAt?new Date(item.publishedAt).toLocaleDateString('tr-TR',{day:'numeric',month:'long',year:'numeric'}):'Güncel';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: item.title,
  description: item.description,
  ...(item.publishedAt ? { datePublished: item.publishedAt } : {}),
  ...(item.image ? { image: [item.image] } : {}),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  articleSection: category?.name ?? 'Yaşam',
  author: { '@type': 'Organization', name: item.sourceOrganization || item.sourceName || 'GÜNCE' },
  publisher: { '@type': 'Organization', name: 'GÜNCE', url: 'https://turkiye-yasam.pages.dev/' }
};
---
<BaseLayout title={item.title+' — Günce'} description={item.description} image={item.image} type="article" structuredData={structuredData}><article class="wrap story-page news-story"><a class="back-link" href={'/kategori/'+(category?.slug??'yasam')+'/'}>← {category?.name??'Yaşam'}</a><header class="story-header"><p class="eyebrow">{contentLabel} · {category?.name??'Yaşam'} · {dateLabel}</p><h1>{item.title}</h1><p class="story-deck">{item.description}</p><p class="news-attribution">{item.attribution || item.sourceName}</p></header>{item.image&&<img class="news-hero-image" src={item.image} alt="" loading="lazy" /> }<div class="story-body news-content" set:html={item.contentHtml || '<p>'+(item.description||'')+'</p>'}></div><div class="news-source-note">{contentLabel} · {item.attribution || item.sourceName} · İçerik {item.sourceName || "kaynak"} tarafından sağlanmıştır. {item.url && <a href={item.url} target="_blank" rel="nofollow noopener noreferrer">Orijinal haberi görüntüle</a>}</div><div class="story-end"><span>GÜNCE.</span><a class="text-link" href="/">Diğer haberlere göz at →</a></div></article></BaseLayout>
