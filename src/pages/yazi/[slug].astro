---
import BaseLayout from '../../layouts/BaseLayout.astro';
import categories from '../../../data/categories.json';
import articles from '../../data/articles.json';
export function getStaticPaths(){return articles.map((article)=>({params:{slug:article.slug},props:{article}}));}
const {article}=Astro.props;
const category=categories.categories.find((c)=>c.id===article.category);
const dateLabel=new Date(article.date+'T12:00:00+03:00').toLocaleDateString('tr-TR',{day:'numeric',month:'long',year:'numeric'});
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.description,
  datePublished: new Date(article.date+'T12:00:00+03:00').toISOString(),
  ...(article.image ? { image: [new URL(article.image, Astro.site).href] } : {}),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  articleSection: category?.name ?? 'Yaşam',
  author: { '@type': 'Organization', name: 'GÜNCE' },
  publisher: { '@type': 'Organization', name: 'GÜNCE', url: 'https://turkiye-yasam.pages.dev/' }
};
---
<BaseLayout title={article.title+' — Günce'} description={article.description} image={article.image} type="article" structuredData={structuredData} noindex={article.demo === true}>
  <article class="wrap story-page">
    <a class="back-link" href={'/kategori/'+(category?.slug??'yasam')+'/'}>← {category?.name??'Yaşam'}</a>
    <header class="story-header">
      <p class="eyebrow">{category?.name??'Yaşam'} · {dateLabel} · {article.readTime} OKUMA</p>
      <h1>{article.title}</h1>
      <p class="story-deck">{article.description}</p>
    </header>
    {article.image
      ? <figure class="article-hero-figure"><img class="article-hero-image" src={article.image} alt={article.imageAlt || article.title} /><figcaption>{article.imageCaption || ''}</figcaption></figure>
      : <div class={'story-visual visual '+(article.visual || 'fashion')}><span class="visual-caption">GÜNCE EDİTORYAL</span><span class="visual-mark">{article.label.toLocaleUpperCase('tr-TR')}</span></div>}
    {article.demo&&<p class="demo-notice">Örnek içerik: Bu yazı tasarım ve sayfa yapısını göstermek için hazırlanmıştır; gerçek haber değildir.</p>}
    <div class="story-body">
      {article.content.map((section)=><section>
        {section.heading && <h2>{section.heading}</h2>}
        {section.paragraphs?.map((paragraph)=><p>{paragraph}</p>)}
        {section.image && <figure class="article-inline-figure"><img src={section.image} alt={section.imageAlt || ''} /><figcaption>{section.imageCaption || ''}</figcaption></figure>}
      </section>)}
    </div>
    <div class="story-end"><span>GÜNCE.</span><a class="text-link" href="/">Diğer yazılara göz at →</a></div>
  </article>
</BaseLayout>
