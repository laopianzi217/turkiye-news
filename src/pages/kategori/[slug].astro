---
import BaseLayout from '../../layouts/BaseLayout.astro';
import categories from '../../../data/categories.json';
import articles from '../../data/articles.json';
import news from '../../data/news.json';
export function getStaticPaths(){return categories.categories.map((category)=>({params:{slug:category.slug},props:{category}}));}
const {category}=Astro.props;
const items=articles.filter((a)=>a.category===category.id);
const newsItems=news.filter((a)=>a.category===category.id);
const brandNewsItems=newsItems.filter((a)=>a.contentType === 'brand_release' || a.sourceId === 'basin-bultenleri');
const agencyNewsItems=newsItems.filter((a)=>!(a.contentType === 'brand_release' || a.sourceId === 'basin-bultenleri'));
---
<BaseLayout title={category.name+' — Günce'} description={category.name+' kategorisinde Günce yazıları ve haberleri.'}><section class="wrap listing-page"><p class="eyebrow">GÜNCE / KATEGORİ</p><h1>{category.name}<span>.</span></h1><p class="listing-intro">Bu kategorideki rehberleri, fikirleri ve güncel haberleri keşfedin.</p>{items.length>0&&<div class="article-grid listing-grid">{items.map((a)=><article class="article-card"><a class={'card-visual visual '+a.visual} href={'/yazi/'+a.slug+'/'}><span class="card-stamp">GÜNCE SEÇKİSİ</span><span class="card-symbol">{a.label.toLocaleUpperCase('tr-TR')}</span></a><div class="card-meta"><span>{category.name}</span><span>{a.readTime} OKUMA</span></div><h3><a href={'/yazi/'+a.slug+'/'}>{a.title}</a></h3><p>{a.description}</p><a class="text-link small-link" href={'/yazi/'+a.slug+'/'}>Yazıyı oku →</a></article>)}</div>}{brandNewsItems.length>0&&<><div class="section-heading category-news-heading"><div><p class="eyebrow">MARKA & KURUM DUYURULARI</p><h2>Marka haberleri</h2></div></div><div class="news-list">{brandNewsItems.map((item)=><article class="news-row"><div class="news-meta"><span>Marka bülteni</span><span>{item.publishedAt?new Date(item.publishedAt).toLocaleDateString('tr-TR'):'Güncel'}</span></div><div><h3><a href={'/haber/'+item.slug+'/'}>{item.title}</a></h3><p>{item.description}</p><small>{item.attribution || item.sourceName}</small></div></article>)}</div></>}{agencyNewsItems.length>0&&<><div class="section-heading category-news-heading"><div><p class="eyebrow">AJANS HABERLERİ</p><h2>Güncel haberler</h2></div></div><div class="news-list">{newsItems.map((item)=><article class="news-row"><div class="news-meta"><span>{category.name}</span><span>{item.publishedAt?new Date(item.publishedAt).toLocaleDateString('tr-TR'):'Güncel'}</span></div><div><h3><a href={'/haber/'+item.slug+'/'}>{item.title}</a></h3><p>{item.description}</p><small>{item.attribution || item.sourceName}</small></div></article>)}</div></>}{items.length===0&&newsItems.length===0&&<div class="empty-state"><h2>Bu bölüm hazırlanıyor.</h2><p>Bu kategori için yeni içerikler geldikçe burada yayınlanacak.</p><a class="text-link" href="/">Ana sayfaya dön →</a></div>}</section></BaseLayout>
