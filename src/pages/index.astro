---
import BaseLayout from '../layouts/BaseLayout.astro';
import categories from '../../data/categories.json';
import articles from '../data/articles.json';
import news from '../data/news.json';
const brandNews = news.filter((item) => item.contentType === 'brand_release' || item.sourceId === 'basin-bultenleri').slice(0, 6);
const sponsorArticle = news.filter((item) => item.sourceId === 'matrixqr-blog').slice(0, 1);
const latestNews = news.filter((item) => !(item.contentType === 'brand_release' || item.sourceId === 'basin-bultenleri')).slice(0, 8);
const featured=articles[0]; const latest=articles.slice(1);
const categoryName=(id)=>categories.categories.find((c)=>c.id===id)?.name ?? 'Yaşam';
---
<BaseLayout><section class="hero wrap"><div class="hero-copy"><p class="eyebrow">YAŞAMIN İÇİNDEN · TÜRKİYE</p><h1>İyi yaşam,<br/><em>iyi seçimlerle</em> başlar.</h1><p class="hero-intro">Stilden sofraya, iyi hissetmekten yeni keşiflere. Günlük hayatınıza ilham veren fikirler ve özgün rehberler.</p><a class="text-link" href="#latest">Keşfet <span>→</span></a></div><a class="feature-visual visual fashion" href={'/yazi/'+featured.slug+'/'}>{featured.image && <img class="editorial-card-image" src={featured.image} alt={featured.imageAlt || featured.title} />}<span class="visual-caption">ÖNE ÇIKAN · {categoryName(featured.category)}</span><span class="visual-mark">STİL<br/>SENİNLE<br/>BAŞLAR.</span><span class="visual-index">01 / 03</span></a></section>
<section class="wrap category-section"><div class="section-heading"><div><p class="eyebrow">KENDİ ROTANI SEÇ</p><h2>Keşfet</h2></div><span class="heading-note">İlgi alanına göre göz at</span></div><div class="category-grid">{categories.categories.slice(0,8).map((c,i)=><a class="category-tile" href={'/kategori/'+c.slug+'/'}><span class="tile-number">0{i+1}</span><span>{c.name}</span><b>↗</b></a>)}</div></section>
<section class="wrap latest-section" id="latest"><div class="section-heading"><div><p class="eyebrow">GÜNCELDEN İLHAM AL</p><h2>Son yazılar</h2></div><span class="heading-note">Editoryal seçkimiz</span></div><div class="article-grid">{latest.map((a,i)=><article class="article-card"><a class={'card-visual visual '+(a.visual || 'fashion')} href={'/yazi/'+a.slug+'/'}>{a.image && <img class="editorial-card-image" src={a.image} alt={a.imageAlt || a.title} />}<span class="card-stamp">GÜNCE / 0{i+2}</span><span class="card-symbol">{a.label.toLocaleUpperCase('tr-TR')}</span></a><div class="card-meta"><span>{categoryName(a.category)}</span><span>{a.readTime} OKUMA</span></div><h3><a href={'/yazi/'+a.slug+'/'}>{a.title}</a></h3><p>{a.description}</p><a class="text-link small-link" href={'/yazi/'+a.slug+'/'}>Yazıyı oku <span>→</span></a></article>)}</div></section>
<section class="wrap latest-section" id="brand-news"><div class="section-heading"><div><p class="eyebrow">MARKA & KURUM DUYURULARI</p><h2>Marka haberleri</h2></div><span class="heading-note">Kaynak gösterilerek yayınlanan basın bültenleri</span></div>{brandNews.length ? <div class="news-list">{brandNews.map((item)=><article class="news-row"><div class="news-meta"><span>Marka bülteni · {categoryName(item.category)}</span><span>{item.publishedAt ? new Date(item.publishedAt).toLocaleDateString('tr-TR') : 'Güncel'}</span></div><div>{item.image && <a href={'/haber/'+item.slug+'/'}><img class="news-thumb" src={item.image} alt="" loading="lazy" /></a>}<h3><a href={'/haber/'+item.slug+'/'}>{item.title}</a></h3>{item.description && <p>{item.description}</p>}<small>{item.attribution || item.sourceName}</small><p><a class="small-link" href={'/haber/'+item.slug+'/'}>Bülteni oku →</a></p></div></article>)}</div> : <div class="empty-state"><p>Yeni marka ve kurum bültenleri geldikçe burada yayınlanacaktır.</p></div>}</section>
<section class="wrap latest-section" id="sponsor-content">{sponsorArticle.length>0&&<><div class="section-heading"><div><p class="eyebrow">İŞ BİRLİĞİ</p><h2>Sponsor içeriği</h2></div><span class="heading-note">MatrixQR tarafından sağlanmıştır</span></div><div class="news-list">{sponsorArticle.map((item)=><article class="news-row sponsor-row"><div class="news-meta"><span>Sponsorlu içerik · Teknoloji</span><span>{item.publishedAt ? new Date(item.publishedAt).toLocaleDateString('tr-TR') : 'Güncel'}</span></div><div>{item.image && <a href={'/haber/'+item.slug+'/'}><img class="news-thumb" src={item.image} alt="" loading="lazy" /></a>}<h3><a href={'/haber/'+item.slug+'/'}>{item.title}</a></h3>{item.description && <p>{item.description}</p>}<small>{item.attribution || item.sourceName}</small><p><a class="small-link" href={'/haber/'+item.slug+'/'}>Makaleyi oku →</a></p></div></article>)}</div></>}</section>
<section class="wrap latest-section" id="news"><div class="section-heading"><div><p class="eyebrow">AJANS HABERLERİ</p><h2>Güncel haberler</h2></div><span class="heading-note">Kaynak gösterilerek yayınlanır</span></div>{latestNews.length ? <div class="news-list">{latestNews.map((item)=><article class="news-row"><div class="news-meta"><span>{categoryName(item.category)}</span><span>{item.publishedAt ? new Date(item.publishedAt).toLocaleDateString('tr-TR') : 'Güncel'}</span></div><div>{item.image && <a href={'/haber/'+item.slug+'/'}><img class="news-thumb" src={item.image} alt="" loading="lazy" /></a>}<h3><a href={'/haber/'+item.slug+'/'}>{item.title}</a></h3>{item.description && <p>{item.description}</p>}<small>{item.attribution || item.sourceName}</small><p><a class="small-link" href={'/haber/'+item.slug+'/'}>Haberi oku →</a></p></div></article>)}</div> : <div class="empty-state"><h2>Haber akışı hazırlanıyor.</h2><p>PHA haberleri kaynak ve yayıncı bilgileriyle birlikte otomatik olarak burada yayınlanacaktır.</p></div>}</section>
<section class="newsletter-band"><div class="wrap band-inner"><p class="eyebrow">GÜNCE'DEN NOT</p><h2>Günlük yaşama<br/><em>küçük bir ilham.</em></h2><p>Moda, lezzet ve yaşam kültürüne dair yeni fikirler burada buluşuyor.</p></div></section></BaseLayout>
